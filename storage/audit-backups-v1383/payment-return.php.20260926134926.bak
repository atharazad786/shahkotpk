<?php
require __DIR__.'/app/bootstrap.php';require __DIR__.'/app/payments.php';require __DIR__.'/app/payfast.php';
$payload=array_merge($_GET,$_POST);$basket=(string)($payload['basket_id']??$payload['BASKET_ID']??'');$gateway=payfast_gateway();$message='Payment response received.';$success=false;
if($basket&&$gateway){$q=db()->prepare("SELECT id FROM payment_orders WHERE reference=? LIMIT 1");$q->execute([$basket]);$orderId=(int)$q->fetchColumn();if($orderId){if(payfast_verify_response($gateway,$payload)){mark_payment_order_paid($orderId,'payfast',(string)($payload['transaction_id']??$payload['TRANSACTION_ID']??''),$payload,null);$message='Payment completed successfully.';$success=true;}elseif(($_GET['result']??'')==='failure'){$message='Payment was not completed.';}}}
?><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Payment - ShahkotPK</title><link rel="stylesheet" href="/assets/shahkotpk-1.6.0.css?v=200"></head><body><section class="section"><div class="city-shell" style="max-width:700px"><div class="custom-card"><h2><?=e($message)?></h2><p><?=$success?'Your payment status and linked account/subscription effects have been updated.':'If money was deducted but your account is not updated, contact support with the payment reference.'?></p><a class="btn btn-green" href="/shopkeeper.php">Open Dashboard</a></div></div></section></body></html>